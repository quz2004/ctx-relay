#!/usr/bin/env bash
# ctx-relay: supervise `claude` (or `agy`, via bin/ctx-relay-agy); when a handoff-then-kill rotation was
# requested by the Stop hook, relaunch a fresh session that reads the handoff. Anything else exits normally.
set -uo pipefail
BACKEND=${CTX_RELAY_BACKEND:-claude}   # claude | agy; bin/ctx-relay-agy sets agy
export CTX_RELAY_BACKEND=$BACKEND
case "$BACKEND" in
  agy)    BASE_DIR=${CTX_RELAY_HOME:-$HOME/.agents/ctx-relay} ;;
  claude) BASE_DIR=${CTX_RELAY_HOME:-$HOME/.claude/ctx-relay} ;;
  *) echo "ctx-relay: unknown CTX_RELAY_BACKEND '$BACKEND' (claude|agy)" >&2; exit 2 ;;
esac
if [[ "${1:-}" == now ]]; then   # ctx-relay now: rotate the current run at its next pause
  d=${CTX_RELAY_RUN_DIR:-$(ls -dt "$BASE_DIR"/runs/*/ 2>/dev/null | head -1)}
  [[ -d "$d" ]] || { echo "ctx-relay: no run found" >&2; exit 1; }
  touch "$d/rotate.now"; echo "ctx-relay: rotation queued for $d (fires at the next pause)"; exit 0
fi
if [[ "${1:-}" == config ]]; then   # ctx-relay config [threshold=N] [growth=N] [emergency=N] [autoclear=on|off] [--save]
  shift; d=${CTX_RELAY_RUN_DIR:-$(ls -dt "$BASE_DIR"/runs/*/ 2>/dev/null | head -1)}
  [[ -d "$d" ]] || { echo "ctx-relay: no run found" >&2; exit 1; }
  save=0; upd=()
  for a in "$@"; do
    case "$a" in
      --save) save=1 ;;
      threshold=*|growth=*|emergency=*|autoclear=*)
        k=${a%%=*}; v=${a#*=}
        case "$k" in
          threshold) K=THRESHOLD ;; growth) K=MIN_GROWTH ;; emergency) K=EMERGENCY ;; autoclear) K=AUTOCLEAR ;;
        esac
        if [[ "$k" == autoclear ]]; then
          case "$v" in on|1) v=1 ;; off|0) v=0 ;; *) echo "ctx-relay: autoclear must be on|off" >&2; exit 2 ;; esac
        else
          [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 1 && v <= 100 )) || { echo "ctx-relay: $k must be 1-100 (percent)" >&2; exit 2; }
        fi
        upd+=("$K=$v") ;;
      *) echo "ctx-relay: unknown setting '$a' (threshold|growth|emergency|autoclear|--save)" >&2; exit 2 ;;
    esac
  done
  touch "$d/config"
  for u in "${upd[@]+"${upd[@]}"}"; do
    sed -i.bak "/^${u%%=*}=/d" "$d/config" && rm -f "$d/config.bak"; echo "$u" >> "$d/config"
  done
  if (( save )); then mkdir -p "$BASE_DIR"; cp "$d/config" "$BASE_DIR/config"; fi
  . "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/ctx-lib.sh"
  CTX_RELAY_RUN_DIR=$d
  printf 'ctx-relay settings (this run%s):\n  threshold  %s%%  (first pause above this asks for a handoff)\n  growth     %s pts  (min growth over a fresh session baseline before rotating again)\n  emergency  %s%%  (interrupt mid-run)\n  autoclear  %s\n' \
    "$( ((save)) && echo ', saved as default')" "$(ctx_cfg THRESHOLD 50)" "$(ctx_cfg MIN_GROWTH 15)" "$(ctx_cfg EMERGENCY 90)" \
    "$([[ $(ctx_cfg AUTOCLEAR 1) == 1 ]] && echo on || echo off)"
  exit 0
fi
SELF=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
ROOT=$(cd "$(dirname "$SELF")/.." && pwd)
if [[ "${1:-}" == install || "${1:-}" == uninstall ]]; then
  if [[ "$BACKEND" == agy ]]; then   # register (or remove) the hooks in <dir>/.agents/hooks.json (default: cwd)
    . "$ROOT/lib/ctx-lib.sh"; ctx_agy_hooks_json "$1" "$ROOT" "${2:-}"; exit $?
  fi
  [[ "$1" == install ]] || { echo "ctx-relay: uninstall is only for the agy backend" >&2; exit 2; }
  # ctx-relay install: add the /relay slash command to ~/.claude/commands
  mkdir -p "$HOME/.claude/commands"
  sed "s|@CTX_RELAY_BIN@|$SELF|g" "$ROOT/commands/relay.md" > "$HOME/.claude/commands/relay.md"
  echo "ctx-relay: installed /relay -> $HOME/.claude/commands/relay.md"; exit 0
fi

if [[ "$BACKEND" == agy ]]; then CLAUDE=${CTX_RELAY_AGY:-agy}; else CLAUDE=${CTX_RELAY_CLAUDE:-claude}; fi
if [[ "$BACKEND" == agy ]]; then
  # Only interactive sessions are supervised. Subcommands (mcp, plugin, models...), print mode and
  # help/version run agy unchanged.
  pass=0
  [[ "${1:-}" != next && -n "${1:-}" && "${1:-}" != -* ]] && pass=1
  for a in "$@"; do case "$a" in -p|--print|--prompt|-h|--help|-v|--version) pass=1 ;; esac; done
  (( pass )) && exec "$CLAUDE" "$@"
fi

if [[ "$BACKEND" == agy ]]; then . "$ROOT/lib/ctx-lib.sh"; ctx_agy_ensure_hooks "$ROOT"; fi
export CTX_RELAY_RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
export CTX_RELAY_RUN_DIR="$BASE_DIR/runs/$CTX_RELAY_RUN_ID"
export CTX_RELAY_WRAPPER_PID=$$
export CTX_RELAY_HANDOFF_DIR=${CTX_RELAY_HANDOFF_DIR:-$PWD}
export CTX_RELAY_THRESHOLD=${CTX_RELAY_THRESHOLD:-50}
export CTX_RELAY_AUTOCLEAR=${CTX_RELAY_AUTOCLEAR:-1}
mkdir -p "$CTX_RELAY_RUN_DIR"
[[ -f "$BASE_DIR/config" ]] && cp "$BASE_DIR/config" "$CTX_RELAY_RUN_DIR/config"   # saved defaults

if [[ "$BACKEND" == claude ]]; then
  # The user's own statusline is chained, not replaced.
  export CTX_RELAY_ORIG_STATUSLINE=$(jq -r '.statusLine.command // empty' "$HOME/.claude/settings.json" 2>/dev/null)
  jq -n --arg stop "$ROOT/hooks/stop.sh" --arg pre "$ROOT/hooks/pretool.sh" --arg sl "$ROOT/hooks/statusline.sh" --arg up "$ROOT/hooks/prompt.sh" '
    {statusLine:{type:"command",command:$sl,refreshInterval:2},
     hooks:{Stop:[{hooks:[{type:"command",command:$stop}]}],
            PreToolUse:[{hooks:[{type:"command",command:$pre}]}],
            UserPromptSubmit:[{hooks:[{type:"command",command:$up}]}]}}' > "$CTX_RELAY_RUN_DIR/settings.json"
fi

# Relaunch args: drop resume/continue flags and a trailing positional prompt.
relaunch_args() {
  local out=() skip=0 a
  for a in "$@"; do
    if (( skip )); then skip=0; [[ "$a" == -* ]] || continue; fi
    case "$a" in
      -c|--continue) continue ;;
      -r|--resume|--session-id|--from-pr) skip=1; continue ;;
      --resume=*|--session-id=*) continue ;;
    esac
    out+=("$a")
  done
  # a final non-flag arg that is not the value of a preceding flag is the initial prompt
  local n=${#out[@]}
  if (( n )) && [[ "${out[n-1]}" != -* ]] && { (( n == 1 )) || [[ "${out[n-2]}" != -* ]] || [[ "${out[n-2]}" == *=* ]]; }; then
    unset 'out[n-1]'
  fi
  (( ${#out[@]} )) && printf '%s\0' "${out[@]}"
}
# agy has no positional prompt: the initial prompt is `-i/--prompt-interactive <text>`, resume is
# `-c/--continue` or `--conversation <id>`. Drop all of those; keep every other flag and its value.
relaunch_args_agy() {
  local out=() skip=0 a
  for a in "$@"; do
    if (( skip )); then skip=0; continue; fi
    case "$a" in
      -c|--continue) continue ;;
      --conversation|-i|--prompt-interactive) skip=1; continue ;;
      --conversation=*|--prompt-interactive=*) continue ;;
    esac
    out+=("$a")
  done
  (( ${#out[@]} )) && printf '%s\0' "${out[@]}"
}
# Start the agent: claude gets our --settings and a positional prompt, agy gets -i <prompt>.
launch() {  # [prompt]
  if [[ "$BACKEND" == agy ]]; then
    "$CLAUDE" "${args[@]}" ${1:+-i "$1"}
  else
    "$CLAUDE" --settings "$CTX_RELAY_RUN_DIR/settings.json" "${args[@]}" ${1:+"$1"}
  fi
}

read_prompt() { printf 'Read %s/%s, then every handoff listed under its Base: chain (oldest context first). Continue from the Next Step. Do not re-explore.' "$CTX_RELAY_HANDOFF_DIR" "$1"; }

rotations=0
first_prompt=""
if [[ "${1:-}" == next ]]; then   # ctx-relay next [flags]: start fresh from the newest handoff
  shift
  . "$ROOT/lib/ctx-lib.sh"
  h=$(ctx_latest_handoff "$CTX_RELAY_HANDOFF_DIR")
  [[ -n "$h" ]] || { echo "ctx-relay: no HANDOFF-*.md in $CTX_RELAY_HANDOFF_DIR" >&2; exit 1; }
  echo "[ctx-relay] continuing from $h" >&2
  first_prompt=$(read_prompt "$h")
  rotations=1   # starts with the handoff already in context: treat like a relaunch (baseline + min growth)
fi
args=("$@")
while :; do
  export CTX_RELAY_ROTATIONS=$rotations
  rm -f "$CTX_RELAY_RUN_DIR"/{rotate.flag,ctx.json,baseline,notified}; echo idle > "$CTX_RELAY_RUN_DIR/state"
  launch "$first_prompt"
  rc=$?
  first_prompt=""
  flag="$CTX_RELAY_RUN_DIR/rotate.flag"
  # claude exits 143 on our SIGTERM; agy exits 0, so for agy the fresh flag (touched only right before the kill) is the signal.
  if [[ -f "$flag" ]] && { [[ "$BACKEND" == agy ]] || (( rc == 143 )); } \
     && (( $(date +%s) - $(stat -c %Y "$flag" 2>/dev/null || stat -f %m "$flag") < 60 )) \
     && [[ -s "$CTX_RELAY_RUN_DIR/handoff" ]]; then
    h=$(cat "$CTX_RELAY_RUN_DIR/handoff")
    [[ -s "$CTX_RELAY_HANDOFF_DIR/$h" ]] || exit $rc
    rotations=$((rotations+1))
    echo "[ctx-relay] rotating (#$rotations) -> $h" >&2
    if [[ "$BACKEND" == agy ]]; then mapfile -d '' kept < <(relaunch_args_agy "$@"); else mapfile -d '' kept < <(relaunch_args "$@"); fi
    args=("${kept[@]}")
    first_prompt=$(read_prompt "$h")
    continue
  fi
  exit $rc
done
