#!/usr/bin/env bash
# Stand-in for `codex`. Drives the real adapter (hooks/codex-hook.sh) with codex-shaped payloads and a
# rollout JSONL in codex's format. Like codex, it exits 2 when SIGTERM'd.
# FAKE_PCT: usage as percent of context window. FAKE_SCENARIO: rotate (default) | quit | stale | manual | nowfile
set -u
HOOK="$(cd "$(dirname "$0")/.." && pwd)/hooks/codex-hook.sh"
n=$(( $(cat "$FAKE_LOG.count" 2>/dev/null || echo 0) + 1 )); echo $n > "$FAKE_LOG.count"
echo "launch $n: $*" >> "$FAKE_LOG"
tr="$FAKE_LOG.rollout.jsonl"
sp=""; trap '[[ -n "$sp" ]] && kill "$sp" 2>/dev/null; exit 2' TERM

# settx PCT [USER_TEXT]: rollout whose token_count reports PCT% of 258400
settx() {
  local win=258400
  local used=$(( $1 * win / 100 ))
  { [[ -n "${2:-}" ]] && jq -cn --arg t "$2" '{type:"response_item",payload:{type:"message",role:"user",content:[{type:"input_text",text:$t}]}}'
    jq -cn --argjson u "$used" --argjson w "$win" '{type:"event_msg",payload:{type:"token_count",info:{last_token_usage:{input_tokens:$u},model_context_window:$w}}}'
  } > "$tr"
}
payload() {
  jq -cn --arg t "$tr" --argjson act "${1:-false}" \
    '{session_id:"sess-123",turn_id:"turn-1",transcript_path:$t,cwd:".",hook_event_name:"Stop",stop_hook_active:$act}'
}
stop() { payload "${1:-false}" | "$HOOK" Stop; }
userprompt() {
  jq -cn --arg p "$1" '{hook_event_name:"UserPromptSubmit",prompt:$p}' | "$HOOK" UserPromptSubmit
}

obey() {
  local reason=$1 path base depth
  path=$(grep -oE "[^ ]*/HANDOFF-[0-9-]+\.md" <<<"$reason" | head -1)
  base=$(grep -oE "Base: [^' ]+" <<<"$reason" | head -1 | cut -d' ' -f2)
  depth=$(grep -oE "Chain depth: [0-9]+" <<<"$reason" | head -1 | cut -d' ' -f3)
  [[ -n "$path" ]] && printf 'Base: %s\nChain depth: %s\n\nbody\n' "${base:-none}" "${depth:-1}" > "$path"
}
idle() { sleep "${FAKE_WAIT:-20}" & sp=$!; wait $sp; exit 0; }   # at prompt; SIGTERM kills with exit 2

if (( n > 1 )); then                         # relaunched session
  for pc in ${FAKE_RELAUNCH_PCTS:-}; do
    settx "$pc" "continue"; echo "relaunch-stop@$pc: $(stop false)" >> "$FAKE_LOG"
  done
  exit 0
fi
case "${FAKE_SCENARIO:-rotate}" in
  quit)  exit 0 ;;
  stale) touch -t 202001010000 "$CTX_RELAY_RUN_DIR/rotate.flag"; echo x > "$CTX_RELAY_RUN_DIR/handoff"; exit 2 ;;
  manual)
    settx 10 "Relay now!"; ctx=$(userprompt "relay now"); echo "prompt: $ctx" >> "$FAKE_LOG"
    out=$(stop false); echo "stop: $out" >> "$FAKE_LOG"
    obey "$(jq -r .reason <<<"$out")"
    echo "stop2: $(stop true)" >> "$FAKE_LOG"
    idle ;;
  selfwrite) printf 'Base: none\nChain depth: 1\n\nself-written\n' > "$CTX_RELAY_HANDOFF_DIR/HANDOFF-2099-01-01-0000.md" ;;
  stalehand) printf 'Base: none\nChain depth: 1\n' > "$CTX_RELAY_HANDOFF_DIR/HANDOFF-2099-01-01-0000.md"
    touch -t 202001010000 "$CTX_RELAY_HANDOFF_DIR/HANDOFF-2099-01-01-0000.md" ;;
  nowfile) touch "$CTX_RELAY_RUN_DIR/rotate.now"; FAKE_PCT=5 ;;
esac
settx "${FAKE_PCT:-60}" "work"
out=$(stop false); echo "stop1: $out" >> "$FAKE_LOG"
for try in 1 2 3 4; do
  [[ "$out" == *'"decision":"block"'* ]] || break
  [[ -z "${FAKE_BAD:-}" ]] && obey "$(jq -r .reason <<<"$out")"
  out=$(stop true); echo "stop$((try+1)): $out" >> "$FAKE_LOG"
done
idle
