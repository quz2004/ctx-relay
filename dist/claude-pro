#!/usr/bin/env bash
set -euo pipefail

# Force Claude Code to prefer subscription OAuth/keychain credentials.
unset ANTHROPIC_API_KEY
unset ANTHROPIC_AUTH_TOKEN
unset ANTHROPIC_BASE_URL
unset CLAUDE_CODE_USE_BEDROCK
unset CLAUDE_CODE_USE_VERTEX
unset CLAUDE_CODE_USE_FOUNDRY
unset ANTHROPIC_BEDROCK_BASE_URL
unset CLAUDE_CODE_SKIP_BEDROCK_AUTH
unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY

args_include_model() {
  for arg in "$@"; do
    case "$arg" in
      --model|--model=*)
        return 0
        ;;
    esac
  done
  return 1
}

sanitize_recent_tool_ids() {
  python3 - <<'PY'
import json
import pathlib
import re
import shutil
import time

base = pathlib.Path.home() / ".claude" / "projects"
if not base.exists():
    raise SystemExit(0)

allowed = re.compile(r"^[a-zA-Z0-9_-]+$")
recent_after = time.time() - 7 * 24 * 60 * 60

def safe_id(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_-]", "_", value)

def sanitize(obj) -> int:
    changed = 0
    if isinstance(obj, dict):
        if obj.get("type") == "tool_use" and "id" in obj and not allowed.match(str(obj["id"])):
            obj["id"] = safe_id(str(obj["id"]))
            changed += 1
        if "tool_use_id" in obj and not allowed.match(str(obj["tool_use_id"])):
            obj["tool_use_id"] = safe_id(str(obj["tool_use_id"]))
            changed += 1
        for key, value in list(obj.items()):
            if isinstance(value, list):
                before = len(value)
                value[:] = [
                    item for item in value
                    if not (
                        isinstance(item, dict)
                        and item.get("type") == "text"
                        and str(item.get("text", "")).strip() == ""
                    )
                ]
                changed += before - len(value)
                if key == "content" and before and not value:
                    value.append({"type": "text", "text": "[empty text removed]"})
            changed += sanitize(value)
    elif isinstance(obj, list):
        before = len(obj)
        obj[:] = [
            item for item in obj
            if not (
                isinstance(item, dict)
                and item.get("type") == "text"
                and str(item.get("text", "")).strip() == ""
            )
        ]
        changed += before - len(obj)
        for value in obj:
            changed += sanitize(value)
    return changed

stamp = time.strftime("%Y%m%d-%H%M%S")
for path in base.rglob("*.jsonl"):
    try:
        if path.stat().st_mtime < recent_after:
            continue
    except OSError:
        continue

    out_lines = []
    changed = 0
    try:
        with path.open(errors="ignore") as handle:
            for line in handle:
                try:
                    obj = json.loads(line)
                except Exception:
                    out_lines.append(line)
                    continue
                changed += sanitize(obj)
                out_lines.append(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")
    except OSError:
        continue

    if changed:
        backup = path.with_name(path.name + f".bak-claude-pro-sanitize-{stamp}")
        shutil.copy2(path, backup)
        path.write_text("".join(out_lines), encoding="utf-8")
        print(f"Sanitized {changed} invalid transcript fields in {path}")
PY
}

case "${1:-}" in
  -h|--help|-v|--version)
    exec claude "$@"
    ;;
esac

if [[ "${CLAUDE_PRO_SANITIZE_ONLY:-}" == "1" ]]; then
  sanitize_recent_tool_ids
  exit 0
fi

sanitize_recent_tool_ids

if [[ -x "$HOME/bin/cognee-project-env" ]]; then
  if project_env="$($HOME/bin/cognee-project-env "$PWD")"; then
    eval "$project_env"
    export COGNEE_PROJECT_ID COGNEE_PROJECT_DATASET
  else
    echo "Warning: Cognee project identity could not be resolved; project memory is disabled." >&2
    unset COGNEE_PROJECT_ID COGNEE_PROJECT_DATASET
  fi
else
  echo "Warning: Cognee project resolver missing; project memory is disabled." >&2
  unset COGNEE_PROJECT_ID COGNEE_PROJECT_DATASET
fi

status_json="$(claude auth status 2>/dev/null || true)"
if ! printf '%s\n' "$status_json" | grep -q '"loggedIn":[[:space:]]*true'; then
  echo "Claude Code is not logged in for subscription mode. Opening Claude.ai login..."
  claude auth login --claudeai
elif printf '%s\n' "$status_json" | grep -q '"authMethod":[[:space:]]*"console"'; then
  echo "Claude Code is currently using Console/API auth. Switching to Claude.ai subscription..."
  claude auth logout >/dev/null 2>&1 || true
  claude auth login --claudeai
fi

# Ensure the SSH tunnel to the cognee-mcp/cognee-api servers on dgx26 is up
# so the cognee MCP server and the cognee-integrations plugin (auto-capture
# hooks, which talk to the REST API, not MCP) are reachable.
if [[ -x "$HOME/bin/ensure-cognee-tunnel" ]] && "$HOME/bin/ensure-cognee-tunnel"; then
  export COGNEE_BASE_URL="http://127.0.0.1:8766"
else
  echo "Warning: DGX26 Cognee tunnel unavailable; Cognee hooks will stay remote and fail softly." >&2
  export COGNEE_BASE_URL="http://cognee-dgx26-unavailable.invalid:8766"
fi

if [[ -z "${COGNEE_API_KEY:-}" && -f "$HOME/.cognee-plugin/api-key" ]]; then
  export COGNEE_API_KEY="$(cat "$HOME/.cognee-plugin/api-key")"
fi
export COGNEE_LLM_KEY_CHECK=off

if [[ -x "$HOME/bin/ensure-qwen-tunnel" ]]; then
  "$HOME/bin/ensure-qwen-tunnel" ||
    echo "Warning: DGX Qwen tunnel unavailable; Qwen models may fail." >&2
fi

claude_pro_gateway_ready=false
if [[ -x "$HOME/.litellm/start-claude-pro-subagents.sh" ]]; then
  if "$HOME/.litellm/start-claude-pro-subagents.sh" && curl -fsS "http://127.0.0.1:4001/v1/models" >/dev/null 2>&1; then
    claude_pro_gateway_ready=true
  else
    echo "Warning: Claude Pro LiteLLM subagent gateway is unavailable; launching direct subscription Claude without LiteLLM subagents." >&2
  fi
else
  echo "Warning: Claude Pro LiteLLM subagent gateway starter missing; LiteLLM subagents may be unavailable." >&2
fi

unset ANTHROPIC_API_KEY
unset ANTHROPIC_AUTH_TOKEN
unset ANTHROPIC_BASE_URL
unset ANTHROPIC_BEDROCK_BASE_URL
unset ANTHROPIC_DEFAULT_HAIKU_MODEL
unset ANTHROPIC_DEFAULT_OPUS_MODEL
unset ANTHROPIC_DEFAULT_SONNET_MODEL
unset AWS_BEARER_TOKEN_BEDROCK
unset CLAUDE_CODE_SKIP_BEDROCK_AUTH
unset CLAUDE_CODE_USE_BEDROCK
unset CLAUDE_CODE_USE_FOUNDRY
unset CLAUDE_CODE_USE_VERTEX
unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY

# Main session should connect transparently to Claude subscription
USE_COGNEE_DEVIN=false
FILTERED_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --cognee-devin|--cognee-llm=devin)
      USE_COGNEE_DEVIN=true
      ;;
    --cognee-llm=primary|--cognee-llm=auto|--cognee-llm=qwen)
      USE_COGNEE_DEVIN=false
      ;;
    *)
      FILTERED_ARGS+=("$arg")
      ;;
  esac
done

if [[ "$USE_COGNEE_DEVIN" == true ]]; then
  if [[ -x "$HOME/bin/cognee-devin-session" ]]; then
    "$HOME/bin/cognee-devin-session" start "$$"
    cleanup_cognee_devin() {
      "$HOME/bin/cognee-devin-session" stop "$$"
    }
    trap cleanup_cognee_devin EXIT INT TERM
  fi
  printf "[claude-pro] Cognee memory routed to Devin ACP bridge\n" >&2
else
  if [[ -x "$HOME/bin/cognee-devin-session" ]]; then
    "$HOME/bin/cognee-devin-session" stop "$$"
  fi
fi

# ctx-relay: restart loop for automatic context rollover (CTX_RELAY_DISABLE=1 bypasses it).
CTX_RELAY_BIN="${CTX_RELAY_BIN:-$HOME/proj/notebooks/ctx-relay/bin/ctx-relay}"
launcher=(claude)
if [[ "${CTX_RELAY_DISABLE:-}" != "1" && -x "$CTX_RELAY_BIN" ]]; then
  launcher=("$CTX_RELAY_BIN")
fi

model_args=()
if ! args_include_model "${FILTERED_ARGS[@]}"; then
  model_args=(--model "${CLAUDE_PRO_MAIN_MODEL:-sonnet}")
fi

if [[ "$USE_COGNEE_DEVIN" == true ]]; then
  "${launcher[@]}" "${model_args[@]}" "${FILTERED_ARGS[@]}"
  exit $?
else
  exec "${launcher[@]}" "${model_args[@]}" "${FILTERED_ARGS[@]}"
fi
